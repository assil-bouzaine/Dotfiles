/* Keybind cheat sheet (keybinds.sh): a centered floating card in the same
 * style as the bar's drop-down cards (waybar/scripts/card.rasi).
 *
 * Click-outside-to-close: rofi covers the screen with a transparent window
 * and the space around the card is invisible buttons bound to kb-cancel. */

configuration {
    click-to-exit: true;
}

* {
    bg:       #101216fa;
    card:     #ffffff0f;
    hover:    #ffffff17;
    fg:       #eceef2;
    dim:      #9299a6;
    cyan:     #33ccff;

    font: "Adwaita Sans Medium 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    fullscreen: true;
    background-color: #00000055;
    orientation: horizontal;
    children: [ dismiss-left, column, dismiss-right ];
}

column {
    expand: false;
    orientation: vertical;
    children: [ dismiss-top, mainbox, dismiss-bottom ];
}

dismiss-left, dismiss-right, dismiss-top, dismiss-bottom {
    expand: true;
    content: "";
    action: "kb-cancel";
    cursor: default;
}

mainbox {
    expand: false;
    width: 760px;
    padding: 14px;
    spacing: 10px;
    border: 1px;
    border-color: #ffffff1c;
    border-radius: 16px;
    background-color: @bg;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 10px 14px;
    spacing: 12px;
    border-radius: 10px;
    background-color: @card;
    children: [ prompt, entry, num-filtered-rows, textbox-sep, num-rows ];
}
prompt { text-color: @cyan; font: "Adwaita Sans Bold 11"; }
entry {
    placeholder: "Search what it does, or a key…";
    placeholder-color: @dim;
    cursor: text;
}
num-filtered-rows, num-rows { expand: false; text-color: @dim; }
textbox-sep { expand: false; str: "/"; text-color: @dim; }

listview {
    /* Fixed height on purpose: dynamic collapses to 0 rows inside the
     * non-expanding column (same as card.rasi). */
    lines: 15;
    fixed-height: true;
    scrollbar: false;
    spacing: 2px;
}

element {
    padding: 7px 10px;
    border-radius: 10px;
}
element normal.normal,
element alternate.normal { background-color: transparent; }
element selected.normal  { background-color: @hover; }
element-text {
    font: "CaskaydiaCove Nerd Font 11";  /* monospace: keybinds.lua pads the key column with spaces */
    text-color: inherit;
    vertical-align: 0.5;
    highlight: underline;
}
