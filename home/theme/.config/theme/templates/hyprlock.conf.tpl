# Generated by ~/.local/bin/theme from templates/hyprlock.conf.tpl: do not edit.
# Sourced at the top of ~/.config/hypr/hyprlock.conf.

$font      = {{ font }}
$bg        = rgb({{ background | rgb }})
$fg        = rgb({{ bright_foreground | rgb }})
$dim       = {{ bright_foreground | hypr:0.6 }}
$inner     = {{ background | hypr:0.6 }}
$outer     = {{ accent | hypr:0.8 }} {{ accent2 | hypr:0.8 }} 45deg
$check     = {{ accent | hypr:0.93 }}
$fail      = {{ red | hypr:0.93 }} {{ orange | hypr:0.93 }} 45deg
$capslock  = {{ yellow | hypr:0.93 }}
$wallpaper = {{ home }}/.local/state/wallpaper-current
# for pango markup (a lone # would start a comment here)
$faint_hex  = ##{{ text_faint | hex }}
$accent_hex = ##{{ accent | hex }}
$red_hex    = ##{{ red | hex }}
