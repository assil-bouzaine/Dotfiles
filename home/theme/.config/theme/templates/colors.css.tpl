/* Generated by ~/.local/bin/theme from templates/colors.css.tpl: do not edit.
 * The current theme's colours and font for GTK surfaces: waybar (style.css),
 * and the screen-share picker. Imported first,
 * so the importing file can use every name below. */

@define-color bg        {{ background }};
@define-color bg_dark   {{ dark_background }};
@define-color surface   {{ lighter_background }};
@define-color fg        {{ foreground }};
@define-color fg_bright {{ bright_foreground }};
@define-color muted     {{ text_muted }};
@define-color faint     {{ text_faint }};
@define-color accent    {{ accent }};
@define-color accent2   {{ accent2 }};
@define-color on_accent {{ on_accent }};
@define-color red       {{ red }};
@define-color orange    {{ orange }};
@define-color yellow    {{ yellow }};
@define-color green     {{ green }};
@define-color blue      {{ blue }};
@define-color magenta   {{ magenta }};

/* panels: islands, cards, tooltips */
@define-color ink       alpha(@bg, 0.93);
@define-color ink_solid alpha(@bg, 0.98);
@define-color edge      alpha(@fg, 0.10);
@define-color rule      alpha(@fg, 0.10);
@define-color lift      alpha(@fg, 0.08);
@define-color field     alpha(@fg, 0.06);
@define-color track     alpha(@fg, 0.13);

* {
    font-family: "{{ font }}", sans-serif;
}
