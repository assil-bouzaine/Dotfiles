    name       = "{{ name }}",
    background = "rgb({{ background | hex }})",
    foreground = "rgb({{ bright_foreground | hex }})",
    titlebar   = "rgb({{ lighter_background | hex }})",
    accent     = "rgb({{ accent | hex }})",
    font       = "{{ font }}",
}

local active   = { colors = { "{{ accent | hypr:0.93 }}", "{{ accent2 | hypr:0.93 }}" }, angle = 45 }
local inactive = "{{ muted | hypr:0.67 }}"

hl.config({
    general = {
        col = { active_border = active, inactive_border = inactive },
    },
    group = {
        col = {
            border_active          = active,
            border_inactive        = inactive,
            border_locked_active   = active,
            border_locked_inactive = inactive,
        },
        groupbar = {
            col = {
                active          = "{{ accent | hypr:0.93 }}",
                inactive        = "{{ muted | hypr:0.67 }}",
                locked_active   = "{{ accent | hypr:0.93 }}",
                locked_inactive = "{{ muted | hypr:0.67 }}",
            },
        },
    },
})

-- conf.d/workspace-modes.lua repaints the floating titlebars with these colours.
if type(THEME_CHANGED) == "function" then
