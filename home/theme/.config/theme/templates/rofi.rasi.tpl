/* Generated by ~/.local/bin/theme from templates/rofi.rasi.tpl: do not edit.
 * Imported by the rofi cards through waybar/scripts/card.rasi. */

* {
    ink:       {{ background | hexa:0.98 }};
    edge:      {{ foreground | hexa:0.11 }};
    field:     {{ foreground | hexa:0.06 }};
    lift:      {{ foreground | hexa:0.09 }};
    scrim:     {{ darker_background | hexa:0.33 }};
    fg:        {{ foreground }};
    muted:     {{ text_muted }};
    faint:     {{ text_faint }};
    accent:    {{ accent }};
    accent2:   {{ accent2 }};
    on-accent: {{ on_accent }};
    red:       {{ red }};
    yellow:    {{ yellow }};

    font:       "{{ font }} Medium 11";
    font-bold:  "{{ font }} Bold 11";
    font-small: "{{ font }} 10";
}

/* search matches in the lists */
element-text {
    highlight: bold {{ accent }};
}
