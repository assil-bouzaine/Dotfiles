#!/usr/bin/env python3
"""tg-bridge: answer Claude Code / Codex from Telegram.

  tg-bridge claude|codex     poll that bot; run as the systemd user unit tg-bridge@<bot>

Only messages from your own chat count, and only fresh ones (10 min), so nothing old gets
typed in after the PC was off. Agents must run in tmux.

  reply to an alert          typed into the session that sent it, then Enter
  plain message              typed into this agent (the session that alerted last)
  buttons on an alert        press that choice, if the same dialog is still on screen
  /new                       start a new session: pick the folder, model and effort,
                             or say them: /new radar opus high (/new ~/code/app sonnet)
  /clear · /compact [notes]  clear or compact the agent's context
  /model · /effort           pick from buttons, or set it straight: /model sonnet, /effort high
  any other /command         typed into the agent as is: /context, /usage, /resume ...
  /screen                    the bottom of the agent's screen
  /key 1 · /key Escape · /key Down Enter      press keys: a letter or digit, Enter,
                             Escape, Tab, Space, BSpace, Up, Down, Left, Right, Home, End,
                             PageUp, PageDown, C-c (any C-x / M-x)
  /list                      open agents and what they're doing
  /claude text · /codex text type into the other agent from either chat (/claude /clear too)
"""
import html
import json
import queue
import re
import sys
import threading
import time
import uuid
from functools import wraps
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib/agent-notify"))
from agentnotify import launch, media, telegram, tmux  # noqa: E402
from agentnotify.store import Store  # noqa: E402

BOT = sys.argv[1] if len(sys.argv) > 1 else ""
if BOT not in telegram.BOTS:
    sys.exit("usage: tg-bridge claude|codex")
TG = telegram.Bot(BOT)
MAX_AGE = 600
SCREEN_CHARS = 3500
KEY = re.compile(r"^(?:[A-Za-z0-9]|Enter|Escape|Tab|BTab|Space|BSpace|Up|Down|Left|Right"
                 r"|Home|End|PageUp|PageDown|[CM]-[a-z])$")
COMMAND = re.compile(r"^/[a-z0-9][\w:.-]*$")
# /effort levels each agent takes (Codex sets them with /model --reasoning=<level>)
EFFORT = {"claude": ("low", "medium", "high", "xhigh", "max", "auto"),
          "codex": ("low", "medium", "high", "xhigh", "max", "ultra")}
COMMANDS = [("new", "Start a new session: folder, model, effort (/new radar opus high)"),
            ("clear", "Clear the context (new session; the old one stays in /resume)"),
            ("compact", "Compact the context, e.g. /compact keep the API notes"),
            ("model", "Switch model: pick from buttons, or /model <name>"),
            ("effort", "Change the effort: pick from buttons, or /effort high"),
            ("screen", "Show the agent's screen"), ("key", "Press keys, e.g. /key 1 or /key Escape"),
            ("list", "Choose a session"), ("control", "Task controls and live status"),
            ("stop", "Interrupt the current task"), ("continue", "Continue the selected task"),
            ("help", "How this works")]
SCREEN_BUTTON = [{"text": "Show screen", "callback_data": "screen"}]
CONTROL_BUTTONS = [[{"text": "Stop", "callback_data": "ctl:stop"},
                    {"text": "Continue", "callback_data": "ctl:continue"}],
                   SCREEN_BUTTON + [{"text": "Refresh status", "callback_data": "ctl:refresh"}],
                   [{"text": "Switch session", "callback_data": "sessions"}]]
_STORE = None
_CONTEXT = threading.local()


def storage():
    global _STORE
    if _STORE is None:
        _STORE = Store(telegram.state_dir() / "bridge.sqlite3")
    return _STORE


def say(text, reply_to=None, html_mode=False, buttons=None, silent=False):
    try:
        return TG.send(text, html_mode=html_mode, buttons=buttons, silent=silent, reply_to=reply_to)
    except telegram.TelegramError as e:
        print("send failed:", e, flush=True)


def ack(text, reply_to):
    """Quiet confirmation: no sound, you're looking at the chat anyway."""
    return say(text, reply_to, silent=True)


# ---- which pane --------------------------------------------------------------

class Live:
    """A snapshot of the open agents, to match alerts (routes) against."""

    def __init__(self):
        self.panes = tmux.panes()
        self.by_id = {p["id"]: p for p in self.panes}
        self.server = tmux.server()

    def of(self, route):
        """The pane an alert came from, if that very session is still running.
        Same tmux server (pane ids restart with tmux) and same agent in that pane."""
        if not route or str(route.get("server")) != self.server:
            return None
        p = self.by_id.get(route.get("pane"))
        return p if p and tmux.same(p, route) else None


def pick(name=None, reply_to=None):
    """(pane, route, error) for a message: a reply goes back to the alert's session."""
    explicit = name is not None
    default_agent = getattr(_CONTEXT, "targets", {}).get(
        "_active_agent", storage().get(BOT, "active_agent", BOT))
    live, name = Live(), name or default_agent
    if reply_to:
        r = telegram.route(BOT, reply_to)
        if not r:
            return None, None, "That message doesn't identify a session. Choose one with /list."
        if explicit and r.get("agent") != name:
            return None, None, f"That reply belongs to another agent. Choose {name.capitalize()} with /list."
        p = live.of(r)
        epochs = getattr(_CONTEXT, "targets", {}).get("_epochs")
        if p and epochs is not None:
            instance, epoch = epochs.get(p["id"], (None, None))
            if instance != p["instance"]:
                p = None
            else:
                p = dict(p, _input_epoch=epoch)
        return (p, r, None) if p else (
            None, None, "That session ended or the alert predates this update. Choose one with /list.")
    captured = getattr(_CONTEXT, "targets", {}).get(name)
    if captured is not None:
        route, error = captured
        p = live.of(route)
        return (dict(p, _input_epoch=route["epoch"]), newest(p, live), None) if p else (
            None, None, error or "That session has ended. Choose one with /list.")
    selected = storage().get(BOT, f"selected:{name}")
    if selected:
        p = live.of(selected)
        return (p, newest(p, live), None) if p else (
            None, None, "Your selected session has ended. Choose another with /list.")
    cands = [p for p in live.panes if p["agent"] == name]
    if not cands:
        return None, None, f"No {name.capitalize()} running in tmux."
    if len(cands) > 1:
        return None, None, "Several sessions are open. Choose one with /list, or reply to its alert."
    if not cands[0].get("instance"):
        return None, None, "Couldn't identify that agent's process. Check the terminal before retrying."
    storage().set(BOT, f"selected:{name}", tmux.identity(cands[0]))
    return cands[0], newest(cands[0], live), None


def newest(p, live):
    """The latest alert this pane sent (it may hold the dialog that's on screen)."""
    return next((r for r in telegram.routes(BOT) if live.of(r) is p), None)


def listing(items):
    return "\n".join(f"{p['agent'].upper():<6} {p['state']:<8} {Path(p['path']).name}  ({p['where']})"
                     for p in items) or "No Claude or Codex running in tmux."


def remember(mid, p, kind, **info):
    """Route a message we sent to pane p: replies and its buttons then reach that session."""
    if mid:
        telegram.remember(BOT, mid, **tmux.identity(p), kind=kind, **info)


# ---- doing things in the pane -------------------------------------------------

def ensure_live(p):
    if not (live := Live().of(tmux.identity(p))):
        raise RuntimeError("That session has ended. Choose one with /list.")
    return live


def terminal_action(fn):
    @wraps(fn)
    def locked(p, *args, **kwargs):
        with tmux.input_lock(p["id"]):
            ensure_live(p)
            return fn(p, *args, **kwargs)
    return locked


def typing_allowed(r, screen, p=None):
    return bool(r and r.get("kind") == "typing" and r.get("anchor")
                and time.time() - r.get("t", 0) <= MAX_AGE
                and (not r.get("prompt") or (p and p.get("prompt") == r["prompt"]))
                and tmux.shows(screen, r.get("anchor") or "")
                and tmux.choices(screen) in ([], r.get("opts")) and not tmux.busy(screen))


def type_into(p, text, state="working", typing=None, require_idle=False):
    def validate():
        if "_input_epoch" in p and p["_input_epoch"] != input_epoch(p):
            raise RuntimeError("That pending request was cancelled by Stop. Send it again to restart it.")
        current = ensure_live(p)
        screen = tmux.screen(p["id"])
        if require_idle and (current["state"] == "working" or tmux.busy(screen)):
            raise RuntimeError("The current task is still working. Use Stop before restarting it.")
        if on_prompt(current) and not typing_allowed(typing, screen, current):
            raise RuntimeError("The agent is waiting on a prompt. Answer it before sending text.")
        if not typing_allowed(typing, screen, current) and not tmux.has_input(screen):
            raise RuntimeError("The agent's input is covered by a panel. Close it with /key Escape.")
    def after():
        if state:
            tmux.checked("set", "-p", "-t", p["id"], "@agent_state", state)
        elif text.split()[0] in ("/clear", "/new"):
            generation = uuid.uuid4().hex
            tmux.checked("set", "-p", "-t", p["id"], "@tg_generation", generation)
    tmux.paste(p["id"], text, validate, after)


def input_epoch(p):
    return storage().get("shared", f"cancel:{p['id']}:{p['instance']}", 0)


def send_text(p, r, text, mid, require_idle=False):
    """Every text path, including cross-agent shortcuts, uses these prompt checks."""
    screen = tmux.screen(p["id"])
    typing = typing_allowed(r, screen, p)
    if not typing and (up := on_prompt(p, r)):
        hold_for_prompt(up, mid, f"{p['agent'].capitalize()} is waiting on a prompt. "
                                "Pick an answer first, then send your message again.")
        telegram.log(BOT, "phone", "message held back: a prompt was on screen")
        return False
    type_into(p, text, typing=r if typing else None, require_idle=require_idle)
    telegram.log(BOT, "phone", f"message typed into {p['agent']} ({p['where']})")
    if typing:
        remember(r["mid"], p, "command")  # free-text permission is consumed once
        sent = ack(f"Answered {p['agent'].capitalize()} · {launch.label(p['path'])}", mid)
        remember(sent, p, "command")
        follow_up(p, r, mid)
    else:
        control_panel(p, mid, sent=True)
    return True


def session_picker(mid=None, page=0):
    live = Live()
    items = sorted(live.panes, key=lambda p: (p["agent"] != BOT, p["path"], p["where"]))
    if not items:
        return say("No Claude or Codex running. /new starts a session.", mid, silent=True)
    page = max(0, min(page, (len(items) - 1) // 8))
    choices = [tmux.identity(p) for p in items[page * 8:(page + 1) * 8]]
    buttons = []
    for i, p in enumerate(items[page * 8:(page + 1) * 8]):
        selected = storage().get(BOT, f"selected:{p['agent']}")
        active = storage().get(BOT, "active_agent", BOT)
        mark = "Selected · " if p["agent"] == active and selected and live.of(selected) == p else ""
        label = f"{mark}{p['agent'].capitalize()} · {launch.label(p['path'])} · {p['where']}"
        buttons.append([{"text": label[:90], "callback_data": f"session:{i}"}])
    nav = []
    if page:
        nav.append({"text": "Previous", "callback_data": f"sessions:{page - 1}"})
    if (page + 1) * 8 < len(items):
        nav.append({"text": "Next", "callback_data": f"sessions:{page + 1}"})
    if nav:
        buttons.append(nav)
    sent = say("Choose a session. It stays selected until you switch or start another.\n"
               "Messages in this chat go to the session you choose.", mid,
               buttons=buttons, silent=True)
    if sent:
        telegram.remember(BOT, sent, kind="sessions", choices=choices)
    return sent


def status_text(p, started=None, sent=False):
    screen = tmux.screen(p["id"])
    busy = tmux.busy(screen)
    prompt = tmux.menu(screen)[0] or tmux.select_list(screen)
    state = "Waiting for your answer" if prompt or p["state"] == "waiting" else "Working" if busy or p["state"] == "working" \
        else "Finished" if p["state"] == "done" else "Ready"
    lines = [heading(p, ""),
             f"<code>{html.escape(launch.tilde(p['path']))}</code> · {html.escape(p['where'])}"]
    if sent:
        lines.append("Message sent.")
    lines.append(f"<b>{state}</b>")
    if prompt:
        lines.append("<pre>" + html.escape(screen[-2000:]) + "</pre>")
    if busy:
        lines.append(html.escape(busy[:180]))
    if started:
        seconds = max(0, int(time.time() - started))
        lines.append(f"Elapsed: {seconds // 60}m {seconds % 60}s")
    lines.append(f"Updated {time.strftime('%H:%M:%S')}")
    return "\n".join(lines), state


def panel_buttons(p):
    up = on_prompt(p)
    return (prompt_buttons(up) + CONTROL_BUTTONS if up else CONTROL_BUTTONS), up


def remember_panel(mid, p, up):
    if up:
        remember(mid, p, up["kind"], opts=up["opts"], anchor=up.get("anchor") or "")
    else:
        remember(mid, p, "control")


def control_panel(p, mid=None, sent=False):
    p = ensure_live(p)
    started = time.time() if sent or p["state"] == "working" else None
    text, state = status_text(p, started, sent)
    buttons, up = panel_buttons(p)
    posted = say(text, mid, html_mode=True, buttons=buttons, silent=True)
    if posted:
        remember_panel(posted, p, up)
        storage().set(BOT, f"monitor:{p['id']}",
                      dict(mid=posted, route=tmux.identity(p), started=started,
                           watching=state == "Working"))
    return posted


@terminal_action
def stop_task(p, mid):
    storage().set("shared", f"cancel:{p['id']}:{p['instance']}", time.time_ns())
    screen = tmux.screen(p["id"])
    if up := on_prompt(p):
        return hold_for_prompt(up, mid, "The agent is waiting for your answer. Pick a choice below.")
    if not tmux.busy(screen) and p["state"] != "working":
        return say(f"{p['agent'].capitalize()} · {launch.label(p['path'])} is already idle.", mid,
                   silent=True)
    tmux.checked("send-keys", "-t", p["id"], "Escape")
    time.sleep(0.4)
    if not tmux.busy(tmux.screen(p["id"])):
        tmux.tmux("set", "-p", "-t", p["id"], "@agent_state", "idle")
    telegram.log(BOT, "phone", f"stop requested in {p['agent']} ({p['where']})")
    control_panel(p, mid)


def continue_task(p, r, mid):
    if not held(p, tmux.screen(p["id"]), "Continue", mid, r):
        return send_text(p, r, "Continue with the current task.", mid, require_idle=True)


def monitor_once():
    for key, item in storage().items(BOT, "monitor:"):
        if not item.get("watching"):
            continue
        p = Live().of(item["route"])
        if not p:
            edit(item["mid"], "This session has ended. /list selects another session.")
            storage().delete(BOT, key)
            continue
        text, state = status_text(p, item.get("started"))
        # A status refresh must not become the newest reply route and take over
        # the free-text answer field opened by a question in another message.
        edit(item["mid"], text, CONTROL_BUTTONS)
        if state != "Working":
            item["watching"] = False
            storage().set(BOT, key, item)


FREE_TEXT = re.compile(r"^\d+\.\s*(type something|other\b|something else|custom)", re.I)


@terminal_action
def press(p, r, n):
    """Pick choice n in the dialog alert r was about. Refuses if that dialog is gone
    (answered at the PC, or a different one is up now)."""
    opts, anchor = r.get("opts") or [], r.get("anchor") or ""
    label = next((o for o in opts if o.split(".")[0] == str(n)), str(n))
    if (r.get("prompt") and p.get("prompt") != r["prompt"]) \
            or not any(o.split(".")[0] == str(n) for o in opts) \
            or not tmux.dialog_is(p["id"], opts, anchor):
        return False, "That prompt is no longer on screen."
    tmux.checked("send-keys", "-t", p["id"], str(n))
    time.sleep(0.8)
    current = ensure_live(p)
    if r.get("prompt") and current.get("prompt") != r["prompt"]:
        return True, f"Answered: {short(label)}"
    if FREE_TEXT.match(label):          # opens a text field: the answer comes as a message
        return True, "Now send your answer as a message."
    if tmux.dialog_is(p["id"], opts, anchor):     # the number only moved the cursor
        tmux.checked("send-keys", "-t", p["id"], "Enter")
        time.sleep(0.8)
        if tmux.dialog_is(p["id"], opts, anchor):
            return False, f"Pressed {n}, but the prompt is still open. Check /screen."
    return True, f"Answered: {short(label)}"


@terminal_action
def choose(p, r, i):
    """Pick row i of an unnumbered list (Claude's folder trust check): move the cursor
    there, check it got there, then Enter. Refused if that list is no longer on screen."""
    opts, text = r.get("opts") or [], tmux.screen(p["id"])
    sel = tmux.select_list(text)
    if not sel or sel[0] != opts or not 0 <= i < len(opts) or not tmux.shows(text, r.get("anchor") or ""):
        return False, "That prompt is no longer on screen."
    for _ in range(abs(i - sel[1])):
        tmux.checked("send-keys", "-t", p["id"], "Down" if i > sel[1] else "Up")
        time.sleep(0.15)
    time.sleep(0.3)
    sel = tmux.select_list(tmux.screen(p["id"]))
    current = ensure_live(p)
    if not sel or sel[0] != opts or sel[1] != i \
            or (r.get("prompt") and current.get("prompt") != r["prompt"]):
        return False, "The cursor didn't land on that choice. Check /screen."
    tmux.checked("send-keys", "-t", p["id"], "Enter")
    return True, f"Answered: {opts[i]}"


def show_screen(p, reply_to):
    ensure_live(p)
    lines = tmux.screen(p["id"]).splitlines()
    while lines and not lines[0].strip():
        lines.pop(0)
    while lines and len("\n".join(lines)) > SCREEN_CHARS:
        lines.pop(0)                          # keep the bottom, where the prompt is
    body = html.escape("\n".join(lines)) or "(blank)"
    sent = say(f"<b>{p['agent'].capitalize()} screen</b>  <i>{html.escape(Path(p['path']).name)}</i>\n"
        f"<pre>{body}</pre>", reply_to, html_mode=True, silent=True)
    remember(sent, p, "screen")


@terminal_action
def cancel_menu(p, r):
    if (r.get("prompt") and p.get("prompt") != r["prompt"]) \
            or not tmux.dialog_is(p["id"], r.get("opts"), r.get("anchor") or ""):
        return False
    for _ in range(3):
        tmux.checked("send-keys", "-t", p["id"], "Escape")
        time.sleep(0.6)
        if not tmux.menu(tmux.screen(p["id"]))[0]:
            break
    return True


def short(option):
    """A menu row without its description column: "3. Sonnet 5.5   Most efficient for…"
    -> "3. Sonnet 5.5"."""
    return re.split(r"\s{2,}", option)[0]


def choice_buttons(opts, menu=False):
    rows = [[{"text": short(o), "callback_data": f"opt:{o.split('.')[0]}"}] for o in opts[:9]]
    return rows + [([{"text": "Cancel", "callback_data": "esc"}] if menu else []) + SCREEN_BUTTON]


def follow_up(p, r, reply_to):
    """Forms with several questions show them one at a time, and Codex's /model asks the
    model, then the effort: once one is answered, send the next one's choices (then the
    final Submit) as a new set of buttons. Returns whether there was a next one."""
    time.sleep(0.5)
    kind = "menu" if r.get("kind") == "menu" else "question"
    # after a menu the transcript is back: a numbered list in a reply must not count
    opts, prompt = (tmux.menu if kind == "menu" else tmux.dialog)(tmux.screen(p["id"]))
    if not opts or tmux.dialog_is(p["id"], r.get("opts"), r.get("anchor") or ""):
        return False
    sent = say(f"<b>Next:</b> {html.escape(prompt)}" if prompt else "<b>Next:</b>", reply_to,
               html_mode=True, buttons=choice_buttons(opts, menu=kind == "menu"), silent=True)
    if sent:
        remember(sent, p, kind, opts=opts, anchor=prompt, cmd=r.get("cmd"))
    return True


# ---- the agent's own slash commands ----------------------------------------------
# /clear, /compact, /model, /effort and anything else that isn't the bridge's own are
# typed into the agent. Never into a prompt (Enter would pick its highlighted answer)
# nor mid-turn; what the agent prints back, or the menu it opens, comes back here.

def heading(p, what):
    return (f"<b>{p['agent'].capitalize()} {html.escape(what)}</b>  "
            f"<i>{html.escape(Path(p['path']).name)}</i>")


def on_prompt(p, r=None):
    """The dialog p waits on, as route info for buttons, or None: the one alert r is about
    if it's still up (it knows the subject), else any menu on screen, numbered or not
    (Claude's folder trust check isn't)."""
    if r and r.get("kind") in ("approval", "question", "menu") and \
            (not r.get("prompt") or p.get("prompt") == r["prompt"]) and \
            tmux.dialog_is(p["id"], r.get("opts"), r.get("anchor") or ""):
        return {k: r.get(k) for k in ("pane", "agent", "server", "instance", "session",
                                      "generation", "prompt", "kind", "opts", "anchor", "cmd")}
    text = tmux.screen(p["id"])
    opts, anchor = tmux.menu(text)
    if opts:
        return dict(**tmux.identity(p), kind="question",
                    opts=opts, anchor=anchor)
    if sel := tmux.select_list(text):
        return dict(**tmux.identity(p), kind="select",
                    opts=sel[0], anchor=sel[2])
    return None


def prompt_buttons(up):
    """Buttons for a prompt on screen: numbered choices press their digit, an unnumbered
    list (kind "select") moves the cursor to the row."""
    if up["kind"] == "select":
        return [[{"text": o[:60], "callback_data": f"sel:{i}"}]
                for i, o in enumerate(up["opts"][:9])] + [SCREEN_BUTTON]
    return choice_buttons(up["opts"], menu=up["kind"] == "menu")


def hold_for_prompt(up, mid, said):
    """Don't type: Enter in a dialog would pick its highlighted choice ("Yes"). Offer the
    choices as buttons instead."""
    sent = say(said, mid, buttons=prompt_buttons(up))
    if sent:
        telegram.remember(BOT, sent, **up)


def held(p, screen, what, mid, r=None):
    """True, after saying why, if `what` can't be typed into p right now."""
    name = p["agent"].capitalize()
    if up := on_prompt(p, r):
        hold_for_prompt(up, mid, f"{name} is waiting on a prompt, so I didn't send {what}. "
                                 "Pick an answer first.")
        telegram.log(BOT, "phone", f"{what} held back: a prompt was on screen")
        return True
    if spin := tmux.busy(screen):
        say(f"{name} is still working, so I didn't send {what}.\n{spin[:80]}\n"
            "Send it again once it's done, or stop it first with /key Escape.", mid)
        telegram.log(BOT, "phone", f"{what} held back: {p['agent']} was working")
        return True
    return False


def slash(text, mid, reply_to=None, name=None):
    word, args = (text.split(maxsplit=1) + [""])[:2]
    word, args = word.split("@")[0].lower(), args.strip()
    if not COMMAND.match(word):    # a bare "/" + Enter would run the first command listed
        return say("That's not a command. /help lists what works here.", mid)
    p, r, err = pick(name, reply_to)
    if err:
        return say(err, mid)
    if word == "/effort":
        if not args:
            return effort_menu(p, mid)
        word, args = ("/model", f"--reasoning={args.lower()}") if p["agent"] == "codex" \
            else (word, args.lower())
    return run(p, f"{word} {args}".rstrip(), mid, r)


def run(p, line, mid, r=None):
    """Type slash command `line` into p, then send back the menu it opened (as buttons)
    or what the agent printed. Returns whether it was typed."""
    before = tmux.screen(p["id"])
    if held(p, before, line.split()[0], mid, r):
        return False
    type_into(p, line, state=None, require_idle=True)  # commands need an idle agent
    if line.split()[0] in ("/clear", "/new"):
        current = next((x for x in tmux.panes() if x["id"] == p["id"]), None)
        if current:
            p = current
            storage().set(BOT, f"selected:{p['agent']}", tmux.identity(p))
    telegram.log(BOT, "phone", f"{line[:60]} typed into {p['agent']} ({p['where']})")
    word = line.split()[0]
    for _ in range(2):                        # give a slow menu a second look
        time.sleep(1.5)
        after = tmux.screen(p["id"])
        opts, anchor = tmux.menu(after)
        if opts or tmux.busy(after) or tmux.news(before, after):
            break
    if opts:
        note = "\nA tap also makes it the default for new sessions." if word == "/model" else ""
        sent = say(f"{heading(p, line)}\nPick one:{note}", mid, html_mode=True,
                   buttons=choice_buttons(opts, menu=True), silent=True)
        if sent:
            remember(sent, p, "menu", opts=opts, anchor=anchor, cmd=line)
    elif word == "/compact" and (tmux.busy(after) or not tmux.news(before, after)):
        ack(f"{p['agent'].capitalize()} is compacting. I'll tell you when it's done.", mid)
        threading.Thread(target=watch, args=(p, line, before, mid), daemon=True).start()
    elif tmux.busy(after):
        ack(f"{p['agent'].capitalize()} is working on {word}. Its reply comes when it's done.", mid)
    else:
        report(p, line, tmux.news(before, after), mid,
               open_screen=not tmux.has_input(after))
    return True


def report(p, line, lines, mid, silent=True, open_screen=False):
    """What the agent printed for a command ("Set model to Sonnet 5.5 ..."). open_screen:
    it's still showing a panel (/status, /config ...) that would swallow the next message."""
    word = (line.split() or [""])[0]
    if word == "/clear":
        lines = ["Cleared: new session, empty context. The old one stays in /resume."]
    for echo in (line, word):                 # Claude echoes the command: only what follows it
        if echo in lines:
            lines = lines[len(lines) - lines[::-1].index(echo):]
            break
    lines = [re.sub(r"^(\w+) · /effort$", r"Effort: \1", l) for l in lines][-30:]
    body = html.escape("\n".join(lines)[-3500:]) or "Done."
    if open_screen:
        body += (f"\n\n<i>{p['agent'].capitalize()} still shows this screen, so anything you send "
                 "goes into it. /key Escape closes it.</i>")
    sent = say(f"{heading(p, line)}\n{body}", mid, html_mode=True, buttons=[SCREEN_BUTTON],
               silent=silent)
    if sent:
        remember(sent, p, "command")


def watch(p, line, before, mid, limit=900):
    """/compact runs for a while: report what the agent says once it's no longer busy."""
    end = time.time() + limit
    while time.time() < end:
        time.sleep(3)
        if not Live().of(tmux.identity(p)):
            return say(f"{p['agent'].capitalize()} closed before {line} finished.", mid)
        now = tmux.screen(p["id"])
        if not tmux.busy(now):
            return report(p, line, tmux.news(before, now), mid, silent=False)
    say(f"{line} still isn't done after {limit // 60} min. Check /screen.", mid)


def effort_menu(p, mid):
    levels = EFFORT[p["agent"]]
    rows = [[{"text": l, "callback_data": f"eff:{l}"} for l in levels[i:i + 3]]
            for i in range(0, len(levels), 3)]
    sent = say(f"{heading(p, '/effort')}\nPick a level:", mid, html_mode=True,
               buttons=rows + [SCREEN_BUTTON], silent=True)
    if sent:
        remember(sent, p, "effort")


# ---- new sessions (/new) -----------------------------------------------------------
# /new asks for the folder, the model and the effort with buttons, editing one message
# as you go; whatever you type after it (/new radar opus high) skips that question. The
# agent starts in a new tmux window the way the tmux project picker does it (a shell,
# then the agent typed in), and its first prompt, if any, comes to you as buttons.
# The wizard's state is a route record for its message: kind "new", dir, model, effort,
# and "choices", the values behind the buttons it shows.

def edit(mid, text, buttons=None):
    try:
        TG.api("editMessageText", chat_id=TG.chat, message_id=mid, text=text, parse_mode="HTML",
               link_preview_options={"is_disabled": True},
               reply_markup={"inline_keyboard": buttons or []})
    except telegram.TelegramError as e:
        if "not modified" not in str(e):
            print("edit failed:", e, flush=True)


def btn(text, data):
    return {"text": text, "callback_data": data}


def rows_of(buttons, n):
    return [buttons[i:i + n] for i in range(0, len(buttons), n)]


def chosen(s):
    """The wizard's answers so far, as lines of its message."""
    lines = [f"<b>New {BOT.capitalize()} session</b>"]
    if s.get("dir"):
        lines.append(f"Folder: <code>{html.escape(launch.tilde(s['dir']))}</code>")
    if s.get("model") is not None:
        lines.append(f"Model: {html.escape(launch.model_label(BOT, s['model']))}")
    if s.get("effort") is not None:
        lines.append(f"Effort: {html.escape(s['effort'] or 'default')}")
    return lines


def wizard(s):
    """(text, buttons, the values behind the buttons) for what /new still needs to know."""
    lines, nav = chosen(s), [btn("Back", "new:back"), btn("Cancel", "new:x")]
    if s.get("note"):
        lines.append(f"<i>{html.escape(s['note'])}</i>")
    if s.get("missing"):
        lines.append(f"There's no folder <code>{html.escape(launch.tilde(s['missing']))}</code>.")
        make = [btn("Create it", "new:mk")] if Path(s["missing"]).parent.is_dir() else []
        return "\n".join(lines), [make + nav], []
    if not s.get("dir"):
        dirs = [str(d) for d in launch.recent_dirs()]
        lines.append("Which folder?")
        return "\n".join(lines), rows_of(
            [btn(launch.label(d), f"new:d:{i}") for i, d in enumerate(dirs)], 2) + \
            [[btn("Other folder…", "new:d:other"), btn("Cancel", "new:x")]], dirs
    if s.get("model") is None:
        options, default = launch.models(BOT)
        lines.append("Which model?")
        return "\n".join(lines), rows_of(
            [btn(name + (" · default" if v == default else ""), f"new:m:{i}")
             for i, (v, name) in enumerate(options)], 2) + [nav], [v for v, _ in options]
    levels, default = launch.efforts(BOT, s["model"])
    lines.append("Which effort?")
    names = [f"Default ({default})" if default else "Default"] + levels
    return "\n".join(lines), rows_of([btn(n, f"new:e:{i}") for i, n in enumerate(names)], 3) \
        + [nav], [""] + levels


def show_wizard(s, mid=None, reply_to=None):
    """Ask /new's next question, editing its message `mid` (or as a new message), or start
    the agent once it knows everything."""
    s = {k: v for k, v in s.items() if k not in ("mid", "t", "note", "choices")} | \
        {"kind": "new", "agent": BOT, "note": s.get("note")}
    if s.get("effort") and s.get("model") is not None and \
            s["effort"] not in launch.efforts(BOT, s["model"])[0]:
        s["note"] = f"{launch.model_label(BOT, s['model'])} doesn't take {s['effort']} effort."
        s["effort"] = None
    if s.get("dir") and s.get("model") is not None and s.get("effort") is not None:
        return start(s, mid, reply_to)
    text, rows, choices = wizard(s)
    if mid:
        edit(mid, text, rows)
    else:
        mid = say(text, reply_to, html_mode=True, buttons=rows, silent=True)
    if mid:
        s.pop("note")
        telegram.remember(BOT, mid, **s, choices=choices)
    return mid


def wizard_input(s, words):
    """Typed answers (/new radar opus high, or a reply to the /new message): an effort
    level, a model, and the rest is the folder."""
    rest = []
    for w in words:
        if w.lower() in launch.all_efforts(BOT):
            s["effort"] = w.lower()
        elif model := launch.as_model(BOT, w):
            s["model"] = model
        else:
            rest.append(w)
    if rest:
        set_folder(s, " ".join(rest))


def set_folder(s, text):
    folder, missing = launch.resolve(text)
    s["dir"], s["missing"] = (str(folder), None) if folder else (None, missing and str(missing))


def new_session(args, mid):
    """/new [claude|codex] [folder] [model] [effort]"""
    words = args.split()
    if words and words[0].lower() in tmux.AGENTS:
        if words[0].lower() != BOT:
            other = words[0].capitalize()
            return say(f"This chat starts {BOT.capitalize()} sessions. For {other}, send /new "
                       f"in the {other} chat.", mid)
        words.pop(0)
    s = {"dir": None, "model": None, "effort": None}
    wizard_input(s, words)
    return show_wizard(s, reply_to=mid)


def ask_folder(wizard_mid):
    """"Other folder…": a message that opens a reply on the phone; the reply is the folder."""
    try:
        sent = TG.api("sendMessage", retries=3, chat_id=TG.chat,
                      text="Send the folder: a project name from ~/Projects, or a path like "
                           "~/code/app or /mnt/data/app.",
                      reply_parameters={"message_id": wizard_mid, "allow_sending_without_reply": True},
                      reply_markup={"force_reply": True,
                                    "input_field_placeholder": "radar, ~/code/app ..."})["message_id"]
    except telegram.TelegramError as e:
        return print("send failed:", e, flush=True)
    telegram.remember(BOT, sent, kind="new-path", agent=BOT, wizard=wizard_mid)


def wizard_reply(r, text, mid):
    """Text sent as a reply to the /new message (any answer), or to its "Send the folder"
    question (the whole text is the folder): carry on with a fresh /new message."""
    wid = r.get("wizard") if r.get("kind") == "new-path" else r.get("mid")
    s = telegram.route(BOT, wid) or {}
    if s.get("kind") != "new":
        return say("That /new is over. Send /new to start another session.", mid)
    if r.get("kind") == "new-path":
        set_folder(s, text)
    else:
        wizard_input(s, text.split())
    try:                                         # its buttons move to the new message
        TG.api("editMessageReplyMarkup", chat_id=TG.chat, message_id=wid,
               reply_markup={"inline_keyboard": []})
    except telegram.TelegramError:
        pass
    telegram.remember(BOT, wid, kind="new-done", agent=BOT)
    return show_wizard(s, reply_to=mid)


def wizard_button(mid, data, s, answer):
    if not s or s.get("kind") != "new":
        return answer("That's over. /new starts another session.")
    choices = s.get("choices") or []
    step, _, arg = data[4:].partition(":")
    asking = {"d": not s.get("dir") and not s.get("missing"),
              "m": bool(s.get("dir")) and s.get("model") is None,
              "e": bool(s.get("dir")) and s.get("model") is not None and s.get("effort") is None}
    if step == "x":
        telegram.remember(BOT, mid, kind="new-done", agent=BOT)
        edit(mid, "\n".join(chosen(s) + ["Cancelled."]))
        return answer("Cancelled")
    if step == "back":
        if s.get("missing"):
            s["missing"] = None
        elif s.get("model") is not None and s.get("effort") is None:
            s["model"] = None
        else:
            s["dir"] = None
    elif step == "d" and arg == "other":
        answer()
        return ask_folder(mid)
    elif step in asking:
        if not asking[step] or not arg.isdigit() or int(arg) >= len(choices):
            return answer("Already picked.")    # a double tap, or an older question
        s[{"d": "dir", "m": "model", "e": "effort"}[step]] = choices[int(arg)]
    elif step == "mk" and s.get("missing"):
        try:
            Path(s["missing"]).mkdir()
        except OSError as e:
            return answer(f"Couldn't create it: {e.strerror or e}")
        telegram.log(BOT, "phone", f"/new: created {launch.tilde(s['missing'])}")
        s["dir"], s["missing"] = s["missing"], None
    else:
        return answer()
    answer()
    return show_wizard(s, mid)


def start(s, mid=None, reply_to=None):
    """Open a tmux window in the chosen folder, type the agent's command line into it, and
    watch it start (come_up)."""
    name = BOT.capitalize()
    try:
        cmd, then = launch.command(BOT, s["model"], s["effort"])
    except ValueError as e:
        return say(f"Can't start {name}: {e}", reply_to or mid)
    head = "\n".join(chosen(s)).replace(f"New {name} session", f"Starting {name}", 1)
    if mid:
        edit(mid, head)
    else:
        mid = say(head, reply_to, html_mode=True, silent=True)
    if mid:
        telegram.remember(BOT, mid, kind="new-done", agent=BOT)   # its buttons are done
    pane_id, where = tmux.new_window(s["dir"], launch.window_name(s["dir"], BOT))
    if not pane_id:
        telegram.log(BOT, "phone", f"/new failed: {where}"[:200])
        return say(f"Couldn't open a tmux window: {where}"[:1000], mid)
    tmux.checked("send-keys", "-t", pane_id, "-l", cmd)
    tmux.checked("send-keys", "-t", pane_id, "Enter")
    telegram.log(BOT, "phone", f"/new: {cmd} in {launch.tilde(s['dir'])} ({where})")
    edit(mid, f"{head}\nWindow {html.escape(where)}, waiting for {name} to start…")
    threading.Thread(target=come_up, args=(pane_id, where, s, then, mid), daemon=True).start()
    return mid


def come_up(pane_id, where, s, then, mid, limit=60):
    """Watch a new agent start: a prompt it asks first (trust this folder?) comes to you
    as buttons; once it's at its input box, say so, with the model and effort it shows."""
    name, t0 = BOT.capitalize(), time.time()
    end, ran, asked = t0 + limit, False, None
    while time.time() < end:
        time.sleep(1)
        info = tmux.pane(pane_id)
        if not info:
            return say(f"The {name} window closed before {name} was ready.", mid)
        text = tmux.screen(pane_id)
        if info["cmd"] != BOT:
            if ran or time.time() - t0 > 20:      # it quit ("No, exit"), or never got going
                tail = [t for t in map(tmux.tidy, text.splitlines()) if t][-6:]
                telegram.log(BOT, "phone", f"/new: {BOT} {'exited' if ran else 'never started'}")
                return say(f"{name} {'exited' if ran else 'did not start'} in {where}:\n"
                           + "\n".join(tail), mid)
            continue
        ran = True
        p = dict(info, agent=BOT)
        if tmux.has_input(text):
            return ready(p, where, s, then, text, mid)
        up = on_prompt(p)
        if up and up["opts"] != (asked or {}).get("opts"):
            asked = up
            lines = [t for t in map(tmux.tidy, text.splitlines()) if t]
            first = tmux.tidy(up["opts"][0])
            cut = next((i for i in range(len(lines) - 1, -1, -1) if lines[i].startswith(first)),
                       len(lines))
            body = html.escape("\n".join(lines[max(0, cut - 8):cut]))
            sent = say(f"<b>{name} asks first</b>  <i>{html.escape(launch.label(info['path']))}</i>"
                       f"\n{body}", mid, html_mode=True, buttons=prompt_buttons(up))
            if sent:
                telegram.remember(BOT, sent, **up)
            end = time.time() + 900                # time for you to answer
    say(f"{name} isn't ready after {int(time.time() - t0)}s. See /screen.", mid)


def ready(p, where, s, then, text, mid):
    """The new session is at its input box: set Codex's effort in it, then tell you, from a
    message that routes your replies there (it's the newest, so plain messages go too)."""
    name = BOT.capitalize()
    detail = launch.claude_banner(text) or launch.describe(BOT, s["model"], s["effort"])
    if then:                                  # Codex: "Model changed to gpt-6-luna low ..."
        type_into(p, then, state=None)
        for _ in range(10):
            time.sleep(0.5)
            if any("changed" in l.lower() for l in tmux.news(text, tmux.screen(p["id"]))):
                break
        else:
            detail += f"\n(I typed {then} but didn't see it confirmed: check /screen)"
    lines = [f"<b>{name} is ready</b>  <i>{html.escape(launch.label(p['path']))}</i>",
             html.escape(detail),
             f"<code>{html.escape(launch.tilde(p['path']))}</code>  ·  window {html.escape(where)}",
             "Send your first message here."]
    sent = say("\n".join(lines), mid, html_mode=True, buttons=[SCREEN_BUTTON], silent=True)
    if sent:
        remember(sent, p, "launch")
        storage().set(BOT, f"selected:{p['agent']}", tmux.identity(p))
        storage().set(BOT, "active_agent", p["agent"])
    telegram.log(BOT, "phone", f"/new: {BOT} ready in {launch.tilde(p['path'])} ({where}) "
                               + detail.split("\n")[0])


# ---- messages -------------------------------------------------------------------

def on_message(msg):
    mid = msg["message_id"]
    text = (msg.get("text") or "").strip()
    reply_to = (msg.get("reply_to_message") or {}).get("message_id")
    if item := media.attachment(msg):
        p, r, err = pick(reply_to=reply_to)
        if err:
            return say(err, mid)
        if up := on_prompt(p, r):
            return hold_for_prompt(up, mid, "Answer the open prompt, then resend the attachment.")
        path, kind = media.download(TG, item)
        caption = (msg.get("caption") or f"Please inspect this {kind}.").strip()
        return send_text(p, r, f"{caption}\n\nAttached {kind}: {json.dumps(str(path))}", mid)
    if not text:
        return say("Send text, a screenshot, or a file. Add a caption to explain what you need.", mid)

    # a folder (model, effort) for /new; /mnt/data/app is a folder, not a command
    if reply_to and (r := telegram.route(BOT, reply_to)) and r.get("kind") in ("new", "new-path") \
            and (r["kind"] == "new-path" or not COMMAND.match(text.split()[0])):
        return wizard_reply(r, text, mid)

    if not text.startswith("/"):
        p, r, err = pick(reply_to=reply_to)
        if err:
            return say(err, mid)
        return send_text(p, r, text, mid)

    cmd, rest = (text.split(maxsplit=1) + [""])[:2]
    cmd, rest = cmd.split("@")[0].lower(), rest.strip()

    if cmd in ("/claude", "/codex"):
        if not rest:
            return say(f"Usage: {cmd} <text>", mid)
        if rest.startswith("/"):
            return slash(rest, mid, reply_to, name=cmd[1:])
        p, r, err = pick(cmd[1:], reply_to)
        if err:
            return say(err, mid)
        return send_text(p, r, rest, mid)

    if cmd in ("/control", "/stop", "/continue"):
        p, r, err = pick(rest if rest in tmux.AGENTS else None, reply_to)
        if err:
            return say(err, mid)
        if cmd == "/stop":
            return stop_task(p, mid)
        if cmd == "/continue":
            return continue_task(p, r, mid)
        return control_panel(p, mid)

    if cmd == "/screen":
        p, _, err = pick(rest if rest in tmux.AGENTS else None, reply_to)
        return say(err, mid) if err else show_screen(p, mid)

    if cmd == "/key":
        keys = rest.split()
        name = keys.pop(0) if keys and keys[0] in tmux.AGENTS else None
        if not keys or len(keys) > 10 or not all(KEY.match(k) for k in keys):
            return say("Usage: /key [claude|codex] <keys>\nKeys: a letter or digit, Enter, Escape, "
                       "Tab, Space, BSpace, Up, Down, Left, Right, C-c ...", mid)
        p, _, err = pick(name, reply_to)
        if err:
            return say(err, mid)
        with tmux.input_lock(p["id"]):
            ensure_live(p)
            for k in keys:
                tmux.checked("send-keys", "-t", p["id"], k)
                time.sleep(0.15)
        telegram.log(BOT, "phone", f"/key {' '.join(keys)} in {p['agent']} ({p['where']})")
        sent = ack(f"Pressed {' '.join(keys)} in {p['agent'].capitalize()} · {launch.label(p['path'])}", mid)
        remember(sent, p, "command")
        return sent

    if cmd == "/new":
        return new_session(rest, mid)

    if cmd == "/list":
        return session_picker(mid)

    if cmd in ("/help", "/start"):
        return say(__doc__.split("\n\n", 2)[2].strip(), mid, silent=True)

    return slash(text, mid, reply_to)            # /clear, /compact, /model ... for the agent


def on_button(q):
    msg = q.get("message") or {}
    if not authorized(msg, q.get("from")):
        return                                   # not your chat: ignore
    mid, data = msg.get("message_id"), q.get("data") or ""

    def answer(text=""):
        try:
            TG.api("answerCallbackQuery", callback_query_id=q["id"], text=text[:190] or None)
        except telegram.TelegramError:
            pass                                 # too old to answer: harmless

    def keyboard(rows):
        try:
            TG.api("editMessageReplyMarkup", chat_id=TG.chat, message_id=mid,
                   reply_markup={"inline_keyboard": rows})
        except telegram.TelegramError:
            pass

    r = telegram.route(BOT, mid)
    if data == "sessions" or re.fullmatch(r"sessions:\d+", data):
        answer()
        return session_picker(mid, int(data.split(":")[1]) if ":" in data else 0)
    if data.startswith("session:") and data[8:].isdigit():
        choices = (r or {}).get("choices") or []
        i = int(data[8:])
        if (r or {}).get("kind") != "sessions" or i >= len(choices):
            return answer("That session list has expired. Use /list.")
        p = Live().of(choices[i])
        if not p:
            return answer("That session has ended. Refresh with /list.")
        storage().set(BOT, f"selected:{p['agent']}", tmux.identity(p))
        storage().set(BOT, "active_agent", p["agent"])
        answer()
        return control_panel(p, mid)
    if data.startswith("new:"):                  # the /new questions: no session yet
        return wizard_button(mid, data, r, answer)
    p = Live().of(r)
    if data == "noop":
        return answer("Already answered.")
    if not p:
        keyboard([])
        return answer("That session has ended.")
    if data in ("ctl:stop", "ctl:continue", "ctl:refresh"):
        answer()
        if data == "ctl:stop":
            return stop_task(p, mid)
        if data == "ctl:continue":
            return continue_task(p, r, mid)
        return control_panel(p, mid)
    if data == "screen":
        answer()
        return show_screen(p, mid)
    if data.startswith("opt:") and data[4:].isdigit():
        if time.time() - r.get("t", 0) > MAX_AGE:
            return answer("That prompt is old. /control refreshes its choices.")
        answer()
        before = tmux.screen(p["id"])
        ok, note = press(p, r, int(data[4:]))
        if ok and note.startswith("Now send"):   # free-text choice: let the next text through
            telegram.remember(BOT, mid, **dict(
                {k: r.get(k) for k in ("pane", "agent", "server", "instance", "session",
                                       "generation", "prompt", "opts", "anchor")}, kind="typing"))
        keyboard([[{"text": note, "callback_data": "noop"}]] if ok
                 else [SCREEN_BUTTON])
        telegram.log(BOT, "phone", f"button on #{mid}: {note}")
        if not ok:
            ack(note, mid)
        if ok and r.get("kind") in ("question", "menu") and not follow_up(p, r, mid) \
                and r.get("kind") == "menu":     # the menu is done: what did the agent say?
            report(p, r.get("cmd") or "", tmux.news(before, tmux.screen(p["id"])), mid)
        return None
    if data.startswith("sel:") and data[4:].isdigit():   # a row of an unnumbered list
        if time.time() - r.get("t", 0) > MAX_AGE:
            return answer("That prompt is old. /control refreshes its choices.")
        answer()
        ok, note = choose(p, r, int(data[4:]))
        keyboard([[{"text": note, "callback_data": "noop"}]] if ok else [SCREEN_BUTTON])
        telegram.log(BOT, "phone", f"button on #{mid}: {note}")
        return ack(note, mid) if not ok else None
    if data == "esc":                            # Cancel under a menu the phone opened
        if not tmux.dialog_is(p["id"], r.get("opts"), r.get("anchor") or ""):
            keyboard([])
            return answer("That menu is no longer on screen.")
        answer()
        if not cancel_menu(p, r):
            return None
        keyboard([[{"text": "Cancelled", "callback_data": "noop"}]])
        telegram.log(BOT, "phone", f"menu on #{mid} cancelled")
        return None
    if data.startswith("eff:") and data[4:] in EFFORT.get(p["agent"], ()):
        level = data[4:]
        answer(f"Effort: {level}")
        return run(p, f"/model --reasoning={level}" if p["agent"] == "codex"
                   else f"/effort {level}", mid)
    return answer()


def capture_targets():
    targets = {"_active_agent": storage().get(BOT, "active_agent", BOT),
               "_epochs": {p["id"]: (p["instance"], input_epoch(p)) for p in tmux.panes()}}
    for name in tmux.AGENTS:
        p, _, error = pick(name)
        targets[name] = (dict(tmux.identity(p), epoch=input_epoch(p)) if p else None, error)
    return targets


def handle_message(update_id, msg, targets):
    _CONTEXT.targets = targets
    try:
        on_message(msg)
    except Exception as e:
        print("handler error:", type(e).__name__, flush=True)
        say(str(e) if isinstance(e, (RuntimeError, ValueError)) else
            "Couldn't complete that request. Check /screen before sending it again.",
            msg.get("message_id"))
    finally:
        _CONTEXT.targets = {}
        storage().finish(BOT, update_id)


def message_worker(inbox):
    while True:
        update_id, msg, targets = inbox.get()
        try:
            handle_message(update_id, msg, targets)
        except Exception as e:
            # A receipt/database failure must not silently kill the input worker.
            # Leave its receipt unfinished so restart recovery reports uncertainty.
            print("message worker error:", type(e).__name__, flush=True)
        finally:
            inbox.task_done()


def maintenance():
    while True:
        try:
            telegram.flush_outbox(BOT)
            monitor_once()
        except Exception as e:
            print("maintenance error:", type(e).__name__, flush=True)
        time.sleep(10)


def authorized(message, sender):
    return (message.get("chat") or {}).get("id") == TG.chat \
        and (message.get("chat") or {}).get("type") == "private" \
        and (sender or {}).get("id") == TG.chat


def main():
    try:
        TG.api("setMyCommands", commands=[{"command": c, "description": d} for c, d in COMMANDS])
    except telegram.TelegramError as e:
        print("setMyCommands failed:", e, flush=True)
    print(f"tg-bridge running ({BOT} bot)", flush=True)
    if storage().recover(BOT):
        telegram.queue_alert(BOT, ["A request was interrupted by a bridge restart. It wasn't replayed. "
                                  "Check /screen before sending it again."])
    inbox = queue.Queue()
    threading.Thread(target=message_worker, args=(inbox,), daemon=True).start()
    threading.Thread(target=maintenance, daemon=True).start()
    offset, backoff = storage().get(BOT, "offset"), 5
    while True:
        try:
            updates = TG.api("getUpdates", http_timeout=65, offset=offset, timeout=50,
                             allowed_updates=["message", "callback_query"])
            backoff = 5
        except telegram.TelegramError as e:
            print("poll failed:", e, flush=True)
            time.sleep(backoff)
            backoff = min(backoff * 2, 60)
            continue
        for u in updates:
            offset = max(offset or 0, u["update_id"] + 1)
            if not storage().claim(BOT, u["update_id"]):
                continue
            dispatched = False
            try:
                if q := u.get("callback_query"):
                    if authorized(q.get("message") or {}, q.get("from")):
                        on_button(q)
                elif (msg := u.get("message")) and (msg.get("chat") or {}).get("id") == TG.chat \
                        and authorized(msg, msg.get("from")) \
                        and 0 <= time.time() - msg.get("date", 0) <= MAX_AGE:
                    targets = capture_targets()
                    cmd = (msg.get("text") or "").split(maxsplit=1)
                    if cmd and cmd[0].split("@")[0].lower() == "/stop":
                        # Interrupts bypass the message worker, including a slow file download.
                        handle_message(u["update_id"], msg, targets)
                    else:
                        inbox.put((u["update_id"], msg, targets))
                        dispatched = True
            except Exception as e:             # keep the bridge alive no matter what
                print("handler error:", type(e).__name__, flush=True)
                if q := u.get("callback_query"):
                    say(str(e) if isinstance(e, RuntimeError) else "That action failed. Check /screen.",
                        (q.get("message") or {}).get("message_id"))
            finally:
                if not dispatched:
                    storage().finish(BOT, u["update_id"])


if __name__ == "__main__":
    main()
