@import "~/.local/state/theme/rofi.rasi"

/* Shared rofi theme for the bar's drop-down cards (apps, Wi-Fi, Bluetooth).
 * Same ink, edge, font and corner as the bar islands (style.css). The card
 * hangs under the bar's right island (launcher.rasi flips it to the left).
 *
 * Click-outside-to-close: rofi covers the whole screen with a transparent
 * window, and the empty space around the card is made of invisible
 * buttons bound to kb-cancel. */

configuration {
    click-to-exit: true;
}

* {
    background-color: transparent;
    text-color: @fg;
}

window {
    fullscreen: true;
    background-color: transparent;
    orientation: horizontal;
    children: [ button-dismiss-side, column, button-dismiss-edge ];
}

column {
    expand: false;
    orientation: vertical;
    children: [ button-dismiss-top, mainbox, button-dismiss-bottom ];
}

/* The invisible click-to-close area around the card */
button-dismiss-side,
button-dismiss-edge,
button-dismiss-top,
button-dismiss-bottom {
    content: "";
    action: "kb-cancel";
    cursor: default;
}
button-dismiss-side   { expand: true; }
button-dismiss-bottom { expand: true; }
button-dismiss-edge   { expand: false; padding: 0 3px; }   /* 6px gap to screen edge */
button-dismiss-top    { expand: false; padding: 11px 0; }  /* bar (4 + 32) + 6px gap */

mainbox {
    expand: false;
    width: 380px;
    padding: 10px;
    spacing: 8px;
    border: 1px;
    border-color: @edge;
    border-radius: 16px;
    background-color: @ink;
    children: [ inputbar, message, listview ];
}

inputbar {
    padding: 9px 14px;
    spacing: 10px;
    border-radius: 10px;
    background-color: @field;
    children: [ prompt, entry ];
}
prompt { text-color: @accent; font: @font-bold; }
entry {
    placeholder: "Search";
    placeholder-color: @faint;
    cursor: text;
}

/* one quiet line of help under the search field */
message { padding: 0 14px; }
textbox {
    text-color: @muted;
    font: @font-small;
    markup: true;
}

listview {
    /* Must be a fixed height: anything dynamic collapses to 0 rows inside
     * the non-expanding column. The scripts pass -l <rows> to fit the list. */
    lines: 7;
    fixed-height: true;
    scrollbar: false;
    spacing: 2px;
}

element {
    padding: 8px 14px;
    spacing: 12px;
    border-radius: 10px;
    cursor: pointer;
    children: [ element-text ];
}
element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active   { background-color: transparent; }
element selected.normal,
element selected.active    { background-color: @lift; }
element-text {
    text-color: inherit;
    vertical-align: 0.5;
    cursor: inherit;
}
