// Waybar top bar (Hyprland, Lua config)
// Managed with GNU Stow from ~/.dotfiles (package: waybar).
// Started from hypr/conf.d/autostart.lua. Reload after edits: pkill waybar && waybar &
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 4,
    "margin-left": 6,    // matches general.gaps_out in hypr/conf.d/look.lua
    "margin-right": 6,
    "spacing": 0,       // style.css joins the modules into three islands

    // Always shown. SUPER + SHIFT + SPACE hides / shows it (scripts/bar-toggle.sh);
    // hidden, its space is given back to the windows.

    "modules-left": [
        "custom/launcher",
        "group/workspaces",
        "group/ws-apps"
    ],
    "modules-center": ["group/center"],
    "modules-right": [
        "group/stats",
        "network",
        "bluetooth",
        "group/apps",
        "custom/notification"
    ],

    // ── Groups (style.css joins them into three islands) ─────────────────

    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/ws-daemon",
            "custom/ws-1", "custom/ws-2", "custom/ws-3", "custom/ws-4", "custom/ws-5",
            "custom/ws-6", "custom/ws-7", "custom/ws-8", "custom/ws-9", "custom/ws-10"
        ]
    },
    "group/ws-apps": {
        "orientation": "horizontal",
        "modules": [
            "image#app-1", "custom/app-1", "image#app-2", "custom/app-2"
        ]
    },
    "group/stats": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "network#speed"]
    },
    "group/apps": {
        "orientation": "horizontal",
        "modules": ["custom/agents", "custom/power", "tray"]
    },
    // Indicators left of the clock, as in Omarchy: night light, stay awake.
    "group/center": {
        "orientation": "horizontal",
        "modules": ["custom/nightlight", "custom/awake", "clock"]
    },

    // ── Left ─────────────────────────────────────────────────────────────

    "custom/launcher": {
        "format": "",
        "tooltip": false,
        "on-click": "pkill -x rofi || rofi -show drun -theme ~/.config/waybar/scripts/launcher.rasi"
    },

    // Workspaces: see scripts/workspaces.py for why this isn't hyprland/workspaces.
    // ws-daemon prints nothing (so it's hidden); it only keeps the daemon alive.
    "custom/ws-daemon": {
        "exec": "~/.config/waybar/scripts/workspaces.py",
        "restart-interval": 2,
        "tooltip": false
    },
    "custom/ws-1": {
        "exec": "sed -n '1p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-2": {
        "exec": "sed -n '2p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-3": {
        "exec": "sed -n '3p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-4": {
        "exec": "sed -n '4p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-5": {
        "exec": "sed -n '5p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-6": {
        "exec": "sed -n '6p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-7": {
        "exec": "sed -n '7p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 7 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-8": {
        "exec": "sed -n '8p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 8 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-9": {
        "exec": "sed -n '9p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 9 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-10": {
        "exec": "sed -n '10p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 10 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    // Apps on the focused workspace: real icon + name per slot, written by
    // scripts/workspaces.py (icons: waybar-ws-icons, names: lines 11-12 of waybar-ws)
    "image#app-1": {
        "exec": "sed -n '1p' \"$XDG_RUNTIME_DIR/waybar-ws-icons\" 2>/dev/null",
        "size": 18,
        "interval": 1,     // not "signal": image modules on a signal freeze waybar 0.15
        "tooltip": false
    },
    "custom/app-1": {
        "exec": "sed -n '11p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once"
    },
    "image#app-2": {
        "exec": "sed -n '2p' \"$XDG_RUNTIME_DIR/waybar-ws-icons\" 2>/dev/null",
        "size": 18,
        "interval": 1,     // not "signal": image modules on a signal freeze waybar 0.15
        "tooltip": false
    },
    "custom/app-2": {
        "exec": "sed -n '12p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once"
    },

    // ── Center ───────────────────────────────────────────────────────────

    "clock": {
        "format": "{:%H:%M<span alpha='62%%' weight='500'>   %a %d %b</span>}",   // %% : a lone % is a date code here
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months":   "<b>{}</b>",
                "weekdays": "<span alpha='55%'><b>{}</b></span>",
                "today":    "<b><u>{}</u></b>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // ── Right: stats ─────────────────────────────────────────────────────

    // cpu / memory: a label, the number, and a thin usage line under them. The
    // line is a CSS background picked by the p0..p100 state (meters.css,
    // scripts/gen-meters.py).
    "cpu": {
        "interval": 2,
        "format": "<span alpha='62%'>cpu</span> {usage}%",
        "states": { "p0": 0, "p5": 5, "p10": 10, "p15": 15, "p20": 20, "p25": 25, "p30": 30, "p35": 35, "p40": 40, "p45": 45, "p50": 50, "p55": 55, "p60": 60, "p65": 65, "p70": 70, "p75": 75, "p80": 80, "p85": 85, "p90": 90, "p95": 95, "p100": 100 },
        "on-click": "~/.config/hypr/scripts/tasks"
    },
    "memory": {
        "interval": 3,
        "format": "<span alpha='62%'>ram</span> {percentage}%",
        "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
        "states": { "p0": 0, "p5": 5, "p10": 10, "p15": 15, "p20": 20, "p25": 25, "p30": 30, "p35": 35, "p40": 40, "p45": 45, "p50": 50, "p55": 55, "p60": 60, "p65": 65, "p70": 70, "p75": 75, "p80": 80, "p85": 85, "p90": 90, "p95": 95, "p100": 100 },
        "on-click": "~/.config/hypr/scripts/tasks"
    },
    "network#speed": {
        "interval": 1,
        "format": "<span alpha='62%'>󰇚</span> {bandwidthDownBytes}",
        "format-disconnected": "<span alpha='62%'>󰇚</span> --",
        "tooltip-format": "↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}"
    },

    // ── Right: connectivity ──────────────────────────────────────────────

    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀  Wired",
        "format-disconnected": "󰤭  Offline",
        "format-disabled": "󰖪  Off",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "interface": "wlan0",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr} on {ifname}\nClick: network card · Right-click: settings",
        "tooltip-format-ethernet": "{ipaddr} on {ifname}",
        "tooltip-format-disconnected": "Click: network card",
        "on-click": "~/.config/quickshell/cards/card netcard",
        "on-click-right": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱",
        "tooltip-format": "Bluetooth: {status}\nClick: Bluetooth card · Right-click: on / off",
        "tooltip-format-connected": "{device_enumerate}\nClick: Bluetooth card · Right-click: on / off",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
        "on-click": "~/.config/quickshell/cards/card bluetooth",
        "on-click-right": "~/.config/quickshell/cards/btctl.sh power toggle"
    },

    // Night light (hyprsunset), see scripts/nightlight.sh
    "custom/nightlight": {
        "exec": "~/.config/waybar/scripts/nightlight.sh",
        "return-type": "json",
        "signal": 9,
        "interval": 30,
        "on-click": "~/.config/waybar/scripts/nightlight.sh toggle",
        "on-scroll-up": "~/.config/waybar/scripts/nightlight.sh warmer",
        "on-scroll-down": "~/.config/waybar/scripts/nightlight.sh cooler"
    },

    // AI agents (Omarchy's robot): limits + usage card, see quickshell/cards/AgentsCard.qml
    "custom/agents": {
        "exec": "~/.config/quickshell/cards/agentsctl.py bar",
        "return-type": "json",
        "signal": 12,
        "interval": 300,
        "on-click": "~/.config/quickshell/cards/card agents",
        "on-click-right": "~/.config/quickshell/cards/agentsctl.py launch claude"
    },

    // Stay awake: no lock / screen off / sleep while on (SUPER + CTRL + I), see scripts/awake.sh
    "custom/awake": {
        "exec": "~/.config/waybar/scripts/awake.sh",
        "return-type": "json",
        "signal": 11,
        "interval": 60,
        "on-click": "~/.config/waybar/scripts/awake.sh toggle"
    },

    // Power profile: balanced (quieter fan) <-> performance, see scripts/power.sh
    "custom/power": {
        "exec": "~/.config/waybar/scripts/power.sh",
        "return-type": "json",
        "signal": 10,
        "interval": 30,
        "on-click": "~/.config/waybar/scripts/power.sh toggle"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 10
    },

    "custom/notification": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚<sup></sup>",
            "none": "󰂜",
            "dnd-notification": "󰂛<sup></sup>",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚<sup></sup>",
            "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󰂛<sup></sup>",
            "dnd-inhibited-none": "󰂛"
        },
        "tooltip": false,
        "escape": true,
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    }
}
