# Shared look for the tmux fzf pickers (proj, agent-dash), sourced by both.
# Colours match the status bar in .tmux.conf.
c_fg='#cdd6f4' c_dim='#6c7086' c_line='#1e1e1e' c_accent='#89b4fa'
c_red='#f38ba8' c_green='#a6e3a1' c_yellow='#f9e2af'

# 24-bit foreground escape for a #rrggbb colour, for use inside list rows.
fg() { printf '\033[38;2;%d;%d;%dm' "0x${1:1:2}" "0x${1:3:2}" "0x${1:5:2}"; }
R=$'\033[0m' B=$'\033[1m'

# Footer of key hints: hints "enter" "jump" "ctrl-r" "refresh" ...
hints() {
    local out= sep=
    while [ $# -ge 2 ]; do
        out+="$sep$(fg "$c_accent")$1$R $(fg "$c_dim")$2$R"
        sep='    '
        shift 2
    done
    printf '%s' "$out"
}

PICKER_OPTS=(
    --ansi --layout=reverse --border=none --no-scrollbar
    --prompt='❯ ' --pointer='▌' --gutter=' ' --highlight-line
    --info=inline-right --input-border=line --footer-border=line
    --delimiter=$'\t' --with-nth=2..
    --color="bg:-1,fg:$c_fg,fg+:$c_fg,bg+:$c_line,hl:$c_accent,hl+:$c_accent:bold"
    --color="prompt:$c_accent,pointer:$c_accent,query:$c_fg,ghost:$c_dim,info:$c_dim"
    --color="border:$c_line,input-border:$c_line,footer-border:$c_line,footer:$c_dim,gutter:-1"
)
