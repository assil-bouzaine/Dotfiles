#!/usr/bin/env python3
"""Rows for the srv picker: your own servers and how much they use.

What counts as yours:
  * user services whose unit file you wrote (~/.config/systemd/user/*.service,
    template instances such as tg-bridge@claude included), running or stopped
  * any other process of yours listening on a TCP port (python -m http.server,
    npm run dev, ...), except desktop apps in APPS below

Hyprland bits (waybar, hypridle, swaync, ...) are skipped by IGNORE; extend it
with SRV_IGNORE='regex' in the environment.

Output: one tab-separated row per server, "id<TAB>display", id being
unit:<name> or pid:<pid>. The first line is the column header.
"""
import glob
import json
import os
import re
import subprocess
import time

UNIT_DIR = os.path.expanduser("~/.config/systemd/user")
IGNORE = re.compile(os.environ.get("SRV_IGNORE", "") or r"hypr|waybar|swaync|swww|awww|xdg-")
APPS = re.compile(
    r"^(Discord|discord|brave|chrome|chromium|firefox|electron|code|codex|claude|"
    r"spotify|steam|kdeconnectd|obsidian|slack|telegram-deskto)$"
)
SAMPLE = 0.4  # seconds between the two CPU readings when there's no earlier one
# srv sets SRV_STATE: each run saves its CPU counters there, so the next run
# (2s later) measures against them instead of sleeping for a fresh sample.
STATE = os.environ.get("SRV_STATE")
HZ = os.sysconf("SC_CLK_TCK")
PAGE = os.sysconf("SC_PAGE_SIZE")


def hexcol(h):
    return "\033[38;2;%d;%d;%dm" % (int(h[1:3], 16), int(h[3:5], 16), int(h[5:7], 16))


FG, DIM, ACCENT = hexcol("#cdd6f4"), hexcol("#6c7086"), hexcol("#89b4fa")
RED, GREEN, YELLOW = hexcol("#f38ba8"), hexcol("#a6e3a1"), hexcol("#f9e2af")
R, B = "\033[0m", "\033[1m"


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def user_units():
    """Service names from unit files you wrote, templates expanded to instances."""
    names = set()
    for path in glob.glob(os.path.join(UNIT_DIR, "*.service")):
        base = os.path.basename(path)
        if base.endswith("@.service"):
            prefix = base[: -len(".service")]
            for line in run("systemctl", "--user", "list-units", "--all", "--plain",
                            "--no-legend", "--type=service", prefix + "*").splitlines():
                names.add(line.split()[0])
            # enabled instances that aren't loaded right now
            for link in glob.glob(os.path.join(UNIT_DIR, "*.wants", prefix + "*.service")):
                names.add(os.path.basename(link))
        else:
            names.add(base)
    return sorted(n for n in names if not IGNORE.search(n))


def show(units):
    if not units:
        return {}
    props = "Id,Description,ActiveState,SubState,MainPID,MemoryCurrent,CPUUsageNSec,ActiveEnterTimestampMonotonic"
    out, cur = {}, {}
    for line in run("systemctl", "--user", "show", "-p", props, *units).splitlines() + [""]:
        if not line:
            if cur:
                out[cur["Id"]] = cur
            cur = {}
            continue
        k, _, v = line.partition("=")
        cur[k] = v
    return out


def proc_cpu(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            fields = f.read().rsplit(")", 1)[1].split()
        return int(fields[11]) + int(fields[12]), int(fields[19])  # utime+stime, starttime
    except (OSError, IndexError, ValueError):
        return None, None


def listeners():
    """pid -> list of ports, for your processes listening on TCP."""
    ports = {}
    for line in run("ss", "-tlnpH").splitlines():
        cols = line.split()
        if len(cols) < 6:
            continue
        port = cols[3].rsplit(":", 1)[-1]
        for pid in re.findall(r"pid=(\d+)", cols[-1]):
            ports.setdefault(int(pid), set()).add(int(port))
    return ports


def unit_of(pid):
    try:
        with open(f"/proc/{pid}/cgroup") as f:
            path = f.read().strip().rsplit("::", 1)[-1]
    except OSError:
        return None
    for part in reversed(path.split("/")):
        if part.endswith(".service"):
            return part
    return None


def fmt_mem(n):
    if n is None:
        return "-"
    for unit, size in (("G", 1 << 30), ("M", 1 << 20), ("K", 1 << 10)):
        if n >= size:
            v = n / size
            return f"{v:.1f}{unit}" if v < 10 and unit != "K" else f"{v:.0f}{unit}"
    return f"{n}B"


def fmt_age(sec):
    if sec is None:
        return "-"
    sec = int(sec)
    d, rem = divmod(sec, 86400)
    h, rem = divmod(rem, 3600)
    m, s = divmod(rem, 60)
    if d:
        return f"{d}d{h}h"
    if h:
        return f"{h}h{m:02d}m"
    if m:
        return f"{m}m{s:02d}s"
    return f"{s}s"


def main():
    units = user_units()
    before = show(units)
    ports = listeners()
    unit_ports, adhoc = {}, []
    for pid, ps in ports.items():
        u = unit_of(pid)
        if u in before:
            unit_ports.setdefault(u, set()).update(ps)
            continue
        try:
            with open(f"/proc/{pid}/comm") as f:
                comm = f.read().strip()
        except OSError:
            continue
        if APPS.match(comm) or IGNORE.search(comm):
            continue
        adhoc.append((pid, comm, ps))

    prev = None
    if STATE:
        try:
            with open(STATE) as f:
                prev = json.load(f)
            if not 0.2 < time.monotonic() - prev["t"] < 10:
                prev = None
        except (OSError, ValueError, KeyError):
            prev = None
    if prev:
        after = before
        t0 = prev["t"]
        unit_cpu0 = prev["units"]
        cpu0 = {pid: prev["pids"].get(f"{pid}:{proc_cpu(pid)[1]}") for pid, _, _ in adhoc}
    else:
        unit_cpu0 = {n: u.get("CPUUsageNSec") for n, u in before.items()}
        cpu0 = {pid: proc_cpu(pid)[0] for pid, _, _ in adhoc}
        t0 = time.monotonic()
        time.sleep(SAMPLE)
        after = show(units)
    t1 = time.monotonic()
    dt = t1 - t0
    now_us = time.clock_gettime(time.CLOCK_MONOTONIC) * 1e6
    snap = {"t": t1, "units": {n: u.get("CPUUsageNSec") for n, u in after.items()}, "pids": {}}
    with open("/proc/uptime") as f:
        uptime = float(f.read().split()[0])

    rows = []  # (sort key, id, state, name, mem, cpu, age, ports, desc)
    for name in units:
        a = after.get(name, {})
        state = a.get("ActiveState", "inactive")
        running = state in ("active", "reloading", "activating", "deactivating")
        mem = cpu = age = None
        if running:
            if a.get("MemoryCurrent", "").isdigit():
                mem = int(a["MemoryCurrent"])
            try:
                cpu = (int(a["CPUUsageNSec"]) - int(unit_cpu0[name])) / 1e9 / dt * 100
                cpu = None if cpu < 0 else cpu  # restarted since the last sample
            except (KeyError, ValueError, TypeError):
                pass
            ts = a.get("ActiveEnterTimestampMonotonic", "0")
            if ts.isdigit() and int(ts):
                age = (now_us - int(ts)) / 1e6
        label = name[: -len(".service")]
        rows.append(((0 if running else 1, label), f"unit:{name}", state, label,
                     mem, cpu, age, unit_ports.get(name, ()), a.get("Description", "")))

    for pid, comm, ps in adhoc:
        ticks, start = proc_cpu(pid)
        if ticks is None:
            continue
        snap["pids"][f"{pid}:{start}"] = ticks
        cpu = (ticks - cpu0[pid]) / HZ / dt * 100 if cpu0.get(pid) is not None else None
        try:
            with open(f"/proc/{pid}/statm") as f:
                mem = int(f.read().split()[1]) * PAGE
            with open(f"/proc/{pid}/cmdline") as f:
                cmd = " ".join(f.read().split("\0")).strip()
            cwd = os.readlink(f"/proc/{pid}/cwd").replace(os.path.expanduser("~"), "~", 1)
        except OSError:
            mem, cmd, cwd = None, comm, ""
        desc = f"{cmd}  in {cwd}" if cwd else cmd
        rows.append(((0, comm), f"pid:{pid}", "active", comm, mem, cpu,
                     uptime - start / HZ, ps, desc))

    if STATE:
        try:
            with open(STATE, "w") as f:
                json.dump(snap, f)
        except OSError:
            pass

    rows.sort(key=lambda r: r[0])
    print("\t" + f"{DIM}  {'STATE':<9} {'NAME':<18} {'RAM':>6} {'CPU':>6} {'UP':>7}  {'PORTS':<11} ABOUT{R}")
    for _, ident, state, label, mem, cpu, age, ps, desc in rows:
        if state == "active":
            dot, color = "●", GREEN
        elif state == "failed":
            dot, color = "✗", RED
        elif state in ("activating", "deactivating", "reloading"):
            dot, color = "◐", YELLOW
        else:
            dot, color = "○", DIM
        stext = {"active": "running", "inactive": "stopped"}.get(state, state)
        name_col = FG + B if state == "active" else DIM
        cpu_s = "-" if cpu is None else f"{cpu:.1f}%"
        cpu_c = RED if cpu and cpu >= 50 else YELLOW if cpu and cpu >= 10 else FG
        port_s = ",".join(f":{p}" for p in sorted(ps)) or "-"
        print(f"{ident}\t{color}{dot} {stext:<9}{R} {name_col}{label[:18]:<18}{R} "
              f"{FG}{fmt_mem(mem):>6}{R} {cpu_c}{cpu_s:>6}{R} {DIM}{fmt_age(age):>7}{R}  "
              f"{ACCENT}{port_s:<11}{R} {DIM}{desc}{R}")


if __name__ == "__main__":
    main()
