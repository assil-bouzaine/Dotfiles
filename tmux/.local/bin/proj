#!/usr/bin/env bash
# Fuzzy-pick a folder in ~/Projects and open agents on it as new windows
# in the current tmux session.
#   enter:  claude
#   ctrl-b: claude + codex
#   ctrl-x: codex
PATH=$HOME/.local/bin:$PATH
. picker-theme

# Most recently touched first: name, git branch, age, agents already open on it
list() {
    local now mtime name branch age open
    now=$(date +%s)
    find ~/Projects -mindepth 1 -maxdepth 1 -type d -printf '%T@\t%f\n' | sort -rn |
        while IFS=$'\t' read -r mtime name; do
            branch=$(git -C ~/Projects/"$name" branch --show-current 2>/dev/null)
            (( ${#branch} > 12 )) && branch="${branch:0:11}…"
            branch=${branch:+ $branch}
            branch+=$(printf '%*s' $(( 14 - ${#branch} )) '')   # pad by characters, not bytes
            age=$(( now - ${mtime%.*} ))
            if   (( age < 3600 ));   then age="$(( age / 60 ))m"
            elif (( age < 86400 ));  then age="$(( age / 3600 ))h"
            elif (( age < 604800 )); then age="$(( age / 86400 ))d"
            else                          age="$(( age / 604800 ))w"; fi
            open=$(agent-list | awk -F'\t' -v p="$name" '$5 == p' | wc -l)
            printf '%s\t%s %s%s%-22s%s %s%s %4s%s  %s\n' "$name" \
                "$(fg "$c_accent")" "" "$R$B" "$name" "$R" \
                "$(fg "$c_dim")" "$branch" "$age" "$R" \
                "$( (( open )) && printf '%s● %d open%s' "$(fg "$c_green")" "$open" "$R")"
        done
}

out=$(list | fzf "${PICKER_OPTS[@]}" --ghost='search projects' \
    --expect=ctrl-b,ctrl-x \
    --footer="$(hints enter claude ctrl-b 'claude + codex' ctrl-x codex)")
key=$(head -n1 <<<"$out")
name=$(sed -n 2p <<<"$out" | cut -f1)
[ -n "$name" ] || exit 0
dir=~/Projects/$name

case $key in
    ctrl-b) agents=(claude codex) ;;
    ctrl-x) agents=(codex) ;;
    *)      agents=(claude) ;;
esac

# Start each agent from a shell so quitting it leaves a usable window behind.
first=
for a in "${agents[@]}"; do
    win=$(tmux new-window -d -P -F '#{window_id}' -c "$dir" -n "$name:$a")
    tmux send-keys -t "$win" "$a" Enter
    [ -n "$first" ] || first=$win
done
tmux select-window -t "$first"
