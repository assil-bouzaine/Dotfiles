// Waybar top bar (Hyprland, Lua config)
// Managed with GNU Stow from ~/.dotfiles (package: waybar).
// Started from hypr/conf.d/autostart.lua. Reload after edits: pkill waybar && waybar &
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 4,
    "margin-left": 6,    // matches general.gaps_out in hypr/conf.d/look.lua
    "margin-right": 6,
    "spacing": 4,

    // Auto-hide: scripts/autohide.py shows the bar while the cursor is at the
    // top edge. Shown, it reserves its space and windows shrink to make room;
    // hidden, the space is given back.
    "start_hidden": true,

    "modules-left": [
        "custom/autohide",
        "custom/launcher",
        "group/workspaces",
        "group/ws-apps"
    ],
    "modules-center": ["clock"],
    "modules-right": [
        "group/stats",
        "network",
        "group/apps",
        "custom/notification"
    ],

    // ── Groups (each one is drawn as a single pill in style.css) ─────────

    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/ws-daemon",
            "custom/ws-1", "custom/ws-2", "custom/ws-3", "custom/ws-4", "custom/ws-5",
            "custom/ws-6", "custom/ws-7", "custom/ws-8", "custom/ws-9", "custom/ws-10"
        ]
    },
    "group/ws-apps": {
        "orientation": "horizontal",
        "modules": [
            "image#app-1", "custom/app-1", "image#app-2", "custom/app-2"
        ]
    },
    "group/stats": {
        "orientation": "horizontal",
        "modules": ["cpu#ring", "cpu", "memory#ring", "memory", "network#speed"]
    },
    "group/apps": {
        "orientation": "horizontal",
        "modules": ["custom/nightlight", "bluetooth", "tray"]
    },

    // ── Left ─────────────────────────────────────────────────────────────

    // autohide prints nothing (so it's hidden); it only keeps the daemon alive.
    "custom/autohide": {
        "exec": "~/.config/waybar/scripts/autohide.py",
        "restart-interval": 2,
        "tooltip": false
    },

    "custom/launcher": {
        "format": "",
        "tooltip": false,
        "on-click": "pkill -x rofi || rofi -show drun -theme ~/.config/waybar/scripts/launcher.rasi"
    },

    // Workspaces: see scripts/workspaces.py for why this isn't hyprland/workspaces.
    // ws-daemon prints nothing (so it's hidden); it only keeps the daemon alive.
    "custom/ws-daemon": {
        "exec": "~/.config/waybar/scripts/workspaces.py",
        "restart-interval": 2,
        "tooltip": false
    },
    "custom/ws-1": {
        "exec": "sed -n '1p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-2": {
        "exec": "sed -n '2p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-3": {
        "exec": "sed -n '3p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-4": {
        "exec": "sed -n '4p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-5": {
        "exec": "sed -n '5p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-6": {
        "exec": "sed -n '6p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-7": {
        "exec": "sed -n '7p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 7 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-8": {
        "exec": "sed -n '8p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 8 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-9": {
        "exec": "sed -n '9p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 9 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws-10": {
        "exec": "sed -n '10p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 10 })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    // Apps on the focused workspace: real icon + name per slot, written by
    // scripts/workspaces.py (icons: waybar-ws-icons, names: lines 11-12 of waybar-ws)
    "image#app-1": {
        "exec": "sed -n '1p' \"$XDG_RUNTIME_DIR/waybar-ws-icons\" 2>/dev/null",
        "size": 18,
        "interval": 1,     // not "signal": image modules on a signal freeze waybar 0.15
        "tooltip": false
    },
    "custom/app-1": {
        "exec": "sed -n '11p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once"
    },
    "image#app-2": {
        "exec": "sed -n '2p' \"$XDG_RUNTIME_DIR/waybar-ws-icons\" 2>/dev/null",
        "size": 18,
        "interval": 1,     // not "signal": image modules on a signal freeze waybar 0.15
        "tooltip": false
    },
    "custom/app-2": {
        "exec": "sed -n '12p' \"$XDG_RUNTIME_DIR/waybar-ws\" 2>/dev/null",
        "return-type": "json",
        "signal": 8,
        "interval": "once"
    },

    // ── Center ───────────────────────────────────────────────────────────

    "clock": {
        "format": "{:%a %d %b  ·  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#33ccff'><b>{}</b></span>",
                "weekdays": "<span color='#5c6370'><b>{}</b></span>",
                "today":    "<span color='#00ff99'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // ── Right: stats ─────────────────────────────────────────────────────

    // cpu#ring / memory#ring: the icon with a usage ring behind it. The ring is
    // a CSS background picked by the p0..p100 state (rings/, scripts/gen-rings.py).
    "cpu#ring": {
        "interval": 2,
        "format": "󰻠",
        "states": { "p0": 0, "p5": 5, "p10": 10, "p15": 15, "p20": 20, "p25": 25, "p30": 30, "p35": 35, "p40": 40, "p45": 45, "p50": 50, "p55": 55, "p60": 60, "p65": 65, "p70": 70, "p75": 75, "p80": 80, "p85": 85, "p90": 90, "p95": 95, "p100": 100 },
        "on-click": "kitty --class bar-htop -e htop"
    },
    "cpu": {
        "interval": 2,
        "format": "{usage}%",
        "states": { "warning": 70, "critical": 90 },
        "on-click": "kitty --class bar-htop -e htop"
    },
    "memory#ring": {
        "interval": 3,
        "format": "󰍛",
        "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
        "states": { "p0": 0, "p5": 5, "p10": 10, "p15": 15, "p20": 20, "p25": 25, "p30": 30, "p35": 35, "p40": 40, "p45": 45, "p50": 50, "p55": 55, "p60": 60, "p65": 65, "p70": 70, "p75": 75, "p80": 80, "p85": 85, "p90": 90, "p95": 95, "p100": 100 },
        "on-click": "kitty --class bar-htop -e htop --sort-key=PERCENT_MEM"
    },
    "memory": {
        "interval": 3,
        "format": "{percentage}%",
        "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
        "states": { "warning": 75, "critical": 90 },
        "on-click": "kitty --class bar-htop -e htop --sort-key=PERCENT_MEM"
    },
    "network#speed": {
        "interval": 1,
        "format": "󰇚  {bandwidthDownBytes}",
        "format-disconnected": "󰇚  --",
        "tooltip-format": "↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}"
    },

    // ── Right: connectivity ──────────────────────────────────────────────

    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀  Wired",
        "format-disconnected": "󰤭  Offline",
        "format-disabled": "󰖪  Off",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "interface": "wlan0",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr} on {ifname}\nClick: pick network · Right-click: settings",
        "tooltip-format-ethernet": "{ipaddr} on {ifname}",
        "tooltip-format-disconnected": "Click: pick network",
        "on-click": "pkill -x rofi || networkmanager_dmenu --config ~/.config/waybar/networkmanager-dmenu.ini",
        "on-click-right": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱  {device_alias}",
        "format-connected-battery": "󰂱  {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}: {status}\nClick: devices · Right-click: power on/off",
        "tooltip-format-connected": "{device_enumerate}\nClick: devices · Right-click: power on/off",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "pkill -x rofi || rofi-bluetooth -theme ~/.config/waybar/scripts/card.rasi -l 8",
        "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || { rfkill unblock bluetooth; sleep 1; bluetoothctl power on; }"
    },

    // Night light (hyprsunset), see scripts/nightlight.sh
    "custom/nightlight": {
        "exec": "~/.config/waybar/scripts/nightlight.sh",
        "return-type": "json",
        "signal": 9,
        "interval": 30,
        "on-click": "~/.config/waybar/scripts/nightlight.sh toggle",
        "on-scroll-up": "~/.config/waybar/scripts/nightlight.sh warmer",
        "on-scroll-down": "~/.config/waybar/scripts/nightlight.sh cooler"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/notification": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚<span foreground='#00ff99'><sup></sup></span>",
            "none": "󰂜",
            "dnd-notification": "󰂛<span foreground='#00ff99'><sup></sup></span>",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚<span foreground='#00ff99'><sup></sup></span>",
            "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󰂛<span foreground='#00ff99'><sup></sup></span>",
            "dnd-inhibited-none": "󰂛"
        },
        "tooltip": false,
        "escape": true,
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    }
}
