/* App launcher card (bar's Arch logo, SUPER + D): the shared card,
 * dropping down under the bar's left island. */

@import "card.rasi"

configuration {
    show-icons: true;
    display-drun: "Apps";
    drun-display-format: "{name}";
}

window { children: [ button-dismiss-edge, column, button-dismiss-side ]; }

mainbox { children: [ inputbar, listview ]; }

entry { placeholder: "Search apps"; }

listview { lines: 8; dynamic: false; }

element { children: [ element-icon, element-text ]; }
element-icon {
    size: 22px;
    vertical-align: 0.5;
    cursor: inherit;
}
