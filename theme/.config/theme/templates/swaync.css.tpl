/* Generated by ~/.local/bin/theme from templates/swaync.css.tpl: do not edit.
 * Imported at the top of ~/.config/swaync/style.css. */

:root {
  --cc-bg: {{ background | rgba:0.98 }};
  --noti-border-color: {{ foreground | rgba:0.11 }};
  --noti-bg: {{ background | rgb }};
  --noti-bg-alpha: 0.98;
  --noti-bg-darker: {{ foreground | rgba:0.06 }};
  --noti-bg-hover: {{ foreground | rgba:0.09 }};
  --noti-bg-focus: transparent;
  --noti-close-bg: {{ foreground | rgba:0.06 }};
  --noti-close-bg-hover: {{ foreground | rgba:0.14 }};
  --text-color: {{ foreground }};
  --text-color-disabled: {{ text_muted }};
  --bg-selected: {{ accent }};

  --accent: {{ accent }};
  --accent2: {{ accent2 }};
  --on-accent: {{ on_accent }};
  --muted: {{ text_muted }};
  --faint: {{ text_faint }};
  --red: {{ red }};
  --yellow: {{ yellow }};
  --green: {{ green }};
}

* {
  font-family: "{{ font }}", sans-serif;
}
